---
import SITE_INFO from "@/config";
// 基础 样式
import "./Footer.less";
---

<footer class="vh-footer">
  <main>
    <p>
      <img src="/assets/images/footer/ing.svg" alt="陈义程" />
      <span class="vh-stat"
        ><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
          ></path></svg
        ><cite>稳定运行</cite><em class="web_time"></em></span
      >
      {
        SITE_INFO.Busuanzi.enable && (
          <>
            <span class="vh-stat" id="busuanzi_container_site_pv">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M12 5c-7.2 0-10 7-10 7s2.8 7 10 7 10-7 10-7-2.8-7-10-7zm0 11.5A4.5 4.5 0 1 1 16.5 12 4.5 4.5 0 0 1 12 16.5zm0-7A2.5 2.5 0 1 0 14.5 12 2.5 2.5 0 0 0 12 9.5z"
                ></path>
              </svg>
              <cite>访问</cite>
              <em id="busuanzi_value_site_pv">-</em>
            </span>
            <span class="vh-stat" id="busuanzi_container_site_uv">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M16 11a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm-8 0a3.5 3.5 0 1 0-3.5-3.5A3.5 3.5 0 0 0 8 11zm8 2c-2.67 0-8 1.34-8 4v1.5h16V17c0-2.66-5.33-4-8-4zM8 13c-.29 0-.62.02-.97.05C4.79 13.8 2 15.02 2 17v1.5h6V17c0-.77.21-1.47.57-2.1A11.3 11.3 0 0 1 8 13z"
                ></path>
              </svg>
              <cite>访客</cite>
              <em id="busuanzi_value_site_uv">-</em>
            </span>
            <a
              class="vh-stat"
              href="https://busuanzi.ibruce.info/"
              target="_blank"
              rel="noopener noreferrer"
              title="访问统计由 不蒜子 提供"
            >
              <cite>统计</cite>
              <em>不蒜子</em>
            </a>
          </>
        )
      }
      <!-- <a
        href="https://analytics.vvhan.com"
        target="_blank"
        rel="noopener noreferrer"
        ><img
          alt="HanAnalytics"
          src="/assets/images/footer/hananalytics.svg"
        /></a
      > -->
    </p>
    <p>
      <a href="https://astro.build/" target="_blank" rel="noopener noreferrer"
        ><img alt="Astro" src="/assets/images/footer/astro.svg" /></a
      ><a
        href="https://github.com/MS-POWERCT/My-Blog"
        target="_blank"
        rel="noopener noreferrer"
        ><img alt="vhAstro-Theme" src="/assets/images/footer/theme.svg" /></a
      >
      <a href="/sitemap-index.xml" target="_blank"
        ><img alt="sitemap" src="/assets/images/footer/sitemap.svg" /></a
      >
      <!--<a href="/rss.xml" target="_blank"
        ><img alt="rss" src="/assets/images/footer/rss.svg" /></a
      >
       <a
        href="https://beian.miit.gov.cn/"
        target="_blank"
        rel="noopener noreferrer"
        ><img alt="icp" src="/assets/images/footer/icp.svg" /></a
      > -->
    </p>
  </main>
</footer>
