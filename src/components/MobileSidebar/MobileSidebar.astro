---
import SITE_CONFIG from "@/config";
const { Navs, Title } = SITE_CONFIG;
// Svg 组件
import Svg from "@/components/Svg/Svg.astro";
// 侧边栏 MobileSidebar 样式
import "./MobileSidebar.less";
---

<nav class="vh-mobilesidebar">
	<section class="main">
		<div class="vh-mobilesidebar-list user-panel">
			<h3>{Title}</h3>
		</div>

		<div class="vh-mobilesidebar-list vh-link-list">
			{
				Navs.map(i => i.children ? (
					<div class="vh-nav-group">
						<p>{i.text}</p>
						{i.children.map(c => (
							<a href={c.link} target={c.target ? "_blank" : "_self"} rel={c.target ? "noopener noreferrer" : undefined}>
								<Svg src={c.icon || i.icon} />
								{c.text}
							</a>
						))}
					</div>
				) : (
					<a class={i.link.replace("/", "")} href={i.link} target={i.target ? "_blank" : "_self"}>
						<Svg src={i.icon} />
						{i.text}
					</a>
				))
			}
		</div>
	</section>
</nav>
